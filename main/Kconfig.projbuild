menu "Perceptron"

    config PERCEPTRON_NODE_NAME
        string "ROS node name"
        default "perceptron"

    config PERCEPTRON_NODE_NAMESPACE
        string "ROS namespace"
        default "perceptron"

    config PERCEPTRON_BLE_DEVICE_NAME
        string "BLE device name"
        default "Perceptron"

    config PERCEPTRON_ROSLOG
        bool "Publish ESP_LOG to ROS topic"
        default y
        help
            Forward ESP_LOG messages tagged PERCEPTRON to a ROS String
            topic (roslog). Useful for debugging over ROS but adds
            overhead. Disable for production deployments.

endmenu
